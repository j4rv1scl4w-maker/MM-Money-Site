# Cloudflare Web Analytics
# Trova il token su: Cloudflare Dashboard → Web Analytics → Sites → Get Beacon Code
# Es: 1234abcd5678ef90...
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Google Search Console verification
# Trova il codice su: GSC → Settings → Ownership verification → HTML tag
# Es: xyzABC123...
NEXT_PUBLIC_GSC_VERIFICATION=
